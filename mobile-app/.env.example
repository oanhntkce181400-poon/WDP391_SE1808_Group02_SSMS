# Copy this file to .env.
# Android emulator uses 10.0.2.2. Real devices should use your machine's LAN IP.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000/api
EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:3000

# Google login for Expo mobile app.
# Native Android/iOS builds require the platform-specific client IDs below.
# EXPO_PUBLIC_GOOGLE_CLIENT_ID is kept only as a legacy web fallback.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_REDIRECT_SCHEME=com.wdp391.ssmsmobile
