@startuml
title Global Error Handling (Tech) - AllExceptionsFilter flow

hide footbox

actor PrimaryActor as "System"
participant APIClient as "API Client (Frontend)"
participant AppRouter as "AppRouter"
participant Controller as "Controller"
participant Service as "Service"
participant ExceptionFilter as "ExceptionFilter"
database DB as "Database"

activate PrimaryActor
PrimaryActor -> APIClient: (1) incoming request
activate APIClient
APIClient -> AppRouter: (2) route dispatch
activate AppRouter
AppRouter -> Controller: (3) controller action
activate Controller

alt controller throws
  Controller --> ExceptionFilter: (3.1) thrown error
  deactivate Controller
  ExceptionFilter -> DB: (3.1.1) log error
  activate DB
  DB --> ExceptionFilter: (3.1.2) return result
  deactivate DB
  ExceptionFilter -> APIClient: (3.1.3) formatted response
  APIClient --> PrimaryActor: (3.1.4) HTTP response
else success
  Controller --> AppRouter: (3.2) return data
  deactivate Controller
  AppRouter --> APIClient: (3.3) success response
  APIClient --> PrimaryActor: (3.4) response
end

deactivate AppRouter
deactivate APIClient
@enduml

