@startuml
hide footbox
title Update/Delete Majors - Modify or Remove Major

actor PrimaryActor as "Admin"
participant Screen as "Screen (Majors List / Edit Modal)"
participant API as "API"
participant Router as "Router"
participant Validation as "Validation"
participant Controller as "Controller"
participant Service as "Service"
participant Model as "Model"
database DB as "Database"

activate PrimaryActor
PrimaryActor -> Screen: (1) Open Majors List and choose Edit or Delete
activate Screen
alt (2.1) Update Major
  Screen -> API: (2.1) call PUT
else (2.2) Delete Major
  Screen -> API: (2.2) call DELETE
end
activate API
API -> Router: (3) forward PUT/DELETE
activate Router
Router -> Validation: (4) validate body / permissions
activate Validation
Validation --> Router: (4.1) ValidationResult { valid: true|false, errors: [] }
deactivate Validation
Router -> Controller: (5) request data
activate Controller
alt (6.1) is update
  Controller -> Service: (6.1) update major
  activate Service
  Service -> Model: (7.1) update data
  activate Model
  Model -> DB: (8.1) db update
  activate DB
  DB --> Model: (9.1) updatedMajor
  deactivate DB
  Model --> Service: (10.1) updatedMajor
  deactivate Model
  Service --> Controller: (11.1) updatedMajor
  deactivate Service
  Controller --> Router: (12.1) 200 OK { updated: updatedMajor }
else (6.2) is delete
  Controller -> Service: (6.2) deleteMajor(id, userId)
  activate Service
  Service -> Model: (7.2) findById(id) -- check if exists
  activate Model
  Model -> DB: (8.2) db query
  activate DB
  DB --> Model: (9.2) rows (empty | [row])
  deactivate DB
  Model --> Service: (10.2) exists = (rows.length > 0)
  alt (10.2.1) exists
    Service -> Model: (10.2.1.1) deleteById(id)
    activate Service
    Model -> DB: (10.2.1.1.1) db delete
    activate DB
    DB --> Model: (10.2.1.1.2) delete result
    deactivate DB
    Model --> Service: (10.2.1.1.3) deleted
    deactivate Model
    Service --> Controller: (10.2.1.1.4) deleted
    deactivate Service
    Controller --> Router: (10.2.1.1.5) 200 OK { deleted: true }
  else (10.2.2) not found
    Model --> Service: (10.2.2) not found -> throw 404
    deactivate Model
    Service --> Controller: (10.2.2.1) 404 Not Found
  end
end
Router --> API: (13) response -> success/error
API --> Screen: (14) display result
Screen --> PrimaryActor: (15) show message
deactivate Router
deactivate API
deactivate Screen
deactivate PrimaryActor
@enduml

