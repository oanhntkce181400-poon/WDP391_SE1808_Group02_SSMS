@startuml
title Update/Delete Curriculum - Modify or Remove Curriculum

hide footbox

actor PrimaryActor as "Admin / Academic Staff"
participant Screen as "Screen (Curriculum Detail / Edit Modal)"
participant API as "API"
participant Router as "Router"
participant Validation as "Validation"
participant Controller as "Controller"
participant Service as "Service"
participant Model as "Model"
participant ModelCurrSub as "CurriculumSubjectModel"
database DB as "Database"

activate PrimaryActor
PrimaryActor -> Screen: (1) Open Curriculum Detail and choose Edit or Delete
activate Screen
alt (2.1) Update Curriculum
  Screen -> API: (2.1) call PUT
else (2.2) Delete Curriculum
  Screen -> API: (2.2) call DELETE
end
activate API
API -> Router: (3) forward PUT/DELETE
activate Router
Router -> Validation: (4) validate body (for update) / check permissions
activate Validation
Validation --> Router: (4.1) ValidationResult { valid: true|false, errors: [] }
deactivate Validation
Router -> Controller: (5) request data
activate Controller
alt (6.1) Update flow
  Controller -> Service: (6.1) update curriculum
  activate Service
  Service -> Model: (7.1) update data
  activate Model
  Model -> DB: (8.1) db update
  activate DB
  DB --> Model: (9.1) updatedCurriculum
  deactivate DB
  Model --> Service: (10.1) updatedCurriculum
  deactivate Model
  Service --> Controller: (11.1) updatedCurriculum
  deactivate Service
  Controller --> Router: (12.1) 200 OK { updated: updatedCurriculum }
else (6.2) Delete flow
  Controller -> Service: (6.2) deleteCurriculum(id, userId)
  activate Service
  Service -> ModelCurrSub: (7.2) deleteMany({ curriculum_id: id }) -- remove subject associations
  activate ModelCurrSub
  ModelCurrSub -> DB: (8.2) db delete
  activate DB
  DB --> ModelCurrSub: (9.2) delete result
  deactivate DB
  ModelCurrSub --> Service: (10.2) associations removed
  deactivate ModelCurrSub
  Service -> Model: (11.2) findByIdAndDelete(id)
  activate Model
  Model -> DB: (11.2.1) db query
  activate DB
  DB --> Model: (11.2.2) rows (empty | [row])
  deactivate DB
  Model --> Service: (11.2.3) exists = (rows.length > 0)
  alt (11.2.3.1) exists
    Service -> Model: (11.2.3.1.1) deleteById(id)
    activate Service
    Model -> DB: (11.2.3.1.1.1) db delete
    activate DB
    DB --> Model: (11.2.3.1.1.2) delete result
    deactivate DB
    Model --> Service: (11.2.3.1.1.3) deleted
    deactivate Model
    Service --> Controller: (11.2.3.1.1.4) deleted
    deactivate Service
    Controller --> Router: (11.2.3.1.1.5) 200 OK { deleted: true }
  else (11.2.3.2) not found
    Model --> Service: (11.2.3.2) not found -> throw 404
    deactivate Model
    Service --> Controller: (11.2.3.2.1) 404 Not Found
  end
end
Router --> API: (12) response -> success/error
API --> Screen: (13) display result
Screen --> PrimaryActor: (14) show message
deactivate Router
deactivate API
deactivate Screen
deactivate PrimaryActor
@enduml

