@startuml
title Add Curriculum - Add New Curriculum for Semester

hide footbox

actor PrimaryActor as "Admin / Academic Staff"
participant Screen as "Screen (Curriculum List)"
participant APIClient as "API Client (Frontend)"
participant CurriculumRouter as "CurriculumRouter"
participant Validation as "ValidationMiddleware"
participant CurriculumController as "CurriculumController"
participant CurriculumService as "CurriculumService"
participant CurriculumModel as "CurriculumModel"
participant SemesterModel as "SemesterModel"
database DB as "Database"

activate PrimaryActor
PrimaryActor -> Screen: (1) open curriculum list
activate Screen

Screen -> APIClient: (2) POST /api/curriculums
activate APIClient
APIClient -> CurriculumRouter: (3) forward POST
activate CurriculumRouter

CurriculumRouter -> Validation: (4) validate body
activate Validation
alt invalid
  Validation --> CurriculumRouter: (4.1.1) invalid payload
  deactivate Validation
  CurriculumRouter --> APIClient: (4.1.2) 400 Bad Request
  APIClient --> Screen: (4.1.3) show validation error
  Screen --> PrimaryActor: (4.1.4) display error
else valid
  deactivate Validation

  CurriculumRouter -> CurriculumController: (4.2.1) request data
  activate CurriculumController
  CurriculumController -> CurriculumService: (4.2.2)  addCurriculum()
  activate CurriculumService

  CurriculumService -> SemesterModel: (4.2.3)  findById()
  activate SemesterModel
  SemesterModel -> DB: (4.2.4)  db query
  activate DB
  DB --> SemesterModel: (4.2.5)  return row | null
  deactivate DB
  SemesterModel --> CurriculumService: (4.2.6)  return row | null
  deactivate SemesterModel

  alt semester not found
    CurriculumService --> CurriculumController: (4.2.6.1.1) validation error
    CurriculumController --> CurriculumRouter: (4.2.6.1.2) 400 Bad Request
    CurriculumRouter --> APIClient: (4.2.6.1.3) 400 Bad Request
    APIClient --> Screen: (4.2.6.1.4) show error
    Screen --> PrimaryActor: (4.2.6.1.4) display error
  else semester exists
    CurriculumService -> CurriculumModel: (4.2.6.2.1) findByCode()
    activate CurriculumModel
    CurriculumModel -> DB: (4.2.6.2.2) db query
    activate DB
    DB --> CurriculumModel: (4.2.6.2.3) return rows
    deactivate DB
    CurriculumModel --> CurriculumService: (4.2.6.2.4) return exists
    deactivate CurriculumModel

    alt exists
      CurriculumService --> CurriculumController: (4.2.6.2.4.1.1) conflict error
     
      CurriculumController --> CurriculumRouter: (4.2.6.2.4.1.2) 409 Conflict
      CurriculumRouter --> APIClient: (4.2.6.2.4.1.3)409 Conflict
      APIClient --> Screen: (4.2.6.2.4.1.4)show error
      Screen --> PrimaryActor:(4.2.6.2.4.1.5) display error
    else not exists
      CurriculumService -> CurriculumModel: (4.2.6.2.4.2.1) create()
      activate CurriculumModel
      CurriculumModel -> DB: (4.2.6.2.4.2.2)db insert
      activate DB
      DB --> CurriculumModel: (4.2.6.2.4.2.3) return created
      deactivate DB
      CurriculumModel --> CurriculumService: (4.2.6.2.4.2.4) return created
      deactivate CurriculumModel

      CurriculumService --> CurriculumController: (4.2.6.2.4.2.5) return created
      deactivate CurriculumService
      CurriculumController --> CurriculumRouter: (4.2.6.2.4.2.6) 201 Created
      deactivate CurriculumController
      CurriculumRouter --> APIClient: (4.2.6.2.4.2.7) 201 Created
      deactivate CurriculumRouter
      APIClient --> Screen: (4.2.6.2.4.2.8) show success
      deactivate APIClient
      Screen --> PrimaryActor: (4.2.6.2.4.2.9) display success
      deactivate Screen
    end
  end
end




deactivate PrimaryActor
@enduml