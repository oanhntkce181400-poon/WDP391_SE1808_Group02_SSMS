<mxfile host="app.diagrams.net">
  <diagram id="CheckTuitionPaymentStatus" name="Check Tuition Payment Status">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Class Diagram: Check Tuition Payment Status&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="420" height="30" as="geometry" />
        </mxCell>

        <!-- FinanceRouter -->
        <mxCell id="FinanceRouter" value="&lt;b&gt;FinanceRouter&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="70" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="FinanceRouter-route" value="GET /api/finance/tuition/bill/:semesterId&#xa;GET /api/finance/payments/curriculum-status&#xa;GET /api/finance/payments/history" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;portConstraint=eastwest;fontSize=10;" vertex="1" parent="FinanceRouter">
          <mxGeometry y="30" width="280" height="30" as="geometry" />
        </mxCell>

        <!-- FinanceController -->
        <mxCell id="FinanceController" value="&lt;b&gt;FinanceController&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="70" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="FinanceController-methods" value="+getMyCurriculumPaymentStatus(req): Response&#xa;+getPaymentHistory(req): Response" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;portConstraint=eastwest;fontSize=10;" vertex="1" parent="FinanceController">
          <mxGeometry y="30" width="280" height="40" as="geometry" />
        </mxCell>

        <!-- FinanceService -->
        <mxCell id="FinanceService" value="&lt;b&gt;FinanceService&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="70" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="FinanceService-methods" value="+getMyTuitionSummary(userId, semesterId?): TuitionSummary&#xa;+getPaymentHistory(userId): Payment[]" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;portConstraint=eastwest;fontSize=10;" vertex="1" parent="FinanceService">
          <mxGeometry y="30" width="280" height="40" as="geometry" />
        </mxCell>

        <!-- Student -->
        <mxCell id="Student" value="&lt;b&gt;Student&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="220" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="Student-fields" value="-id: ObjectId&#xa;-userId: ObjectId&#xa;-studentCode: string&#xa;-majorCode: string&#xa;-curriculumId: ObjectId" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;portConstraint=eastwest;fontSize=10;" vertex="1" parent="Student">
