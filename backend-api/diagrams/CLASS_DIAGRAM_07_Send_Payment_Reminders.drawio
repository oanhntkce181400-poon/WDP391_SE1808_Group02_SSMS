<mxfile host="app.diagrams.net">
  <diagram id="PaymentReminders" name="Send Payment Reminders">
    <mxGraphModel dx="1200" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Class Diagram: Send Payment Reminders" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="480" height="30" as="geometry" />
        </mxCell>

        <mxCell id="R1" value="PaymentReminderRouter" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="55" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="R1r" value="POST /api/payment-reminders/send" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="R1">
          <mxGeometry y="30" width="300" height="30" as="geometry" />
        </mxCell>

        <mxCell id="C1" value="PaymentReminderController" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="55" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="C1m" value="+sendReminders(req): Response" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="C1">
          <mxGeometry y="30" width="320" height="30" as="geometry" />
        </mxCell>

        <mxCell id="S1" value="PaymentReminderService" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="740" y="55" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="S1m" value="+sendBatchReminders(studentIds, options): BatchResult&#xa;+sendReminder(studentId, options): ReminderResult&#xa;+canSendReminder(studentId, options): CooldownInfo&#xa;+getStudentsWithOutstandingFees(filters): StudentDebtRow[]" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="S1">
          <mxGeometry y="30" width="360" height="80" as="geometry" />
        </mxCell>

        <mxCell id="M1" value="EmailService" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="M1m" value="+sendPaymentReminder(params): void" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="M1">
          <mxGeometry y="30" width="280" height="30" as="geometry" />
        </mxCell>

        <mxCell id="E1" value="Student" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="200" width="220" height="100" as="geometry" />
