        <mxCell id="E2" value="TuitionBill" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="200" width="240" height="110" as="geometry" />
        </mxCell>
