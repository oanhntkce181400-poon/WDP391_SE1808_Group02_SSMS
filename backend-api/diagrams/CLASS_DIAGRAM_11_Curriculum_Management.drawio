<mxfile host="app.diagrams.net">
  <diagram id="CurriculumManagement" name="Curriculum Management">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Class Diagram: Curriculum Management&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="400" height="30" as="geometry" />
        </mxCell>

        <!-- CurriculumRouter -->
        <mxCell id="CurriculumRouter" value="&lt;b&gt;CurriculumRouter&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="70" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="CurriculumRouter-route" value="GET /api/curriculums&#xa;GET /api/curriculums/:id&#xa;GET /api/curriculums/:id/details&#xa;POST /api/curriculums&#xa;PUT /api/curriculums/:id&#xa;DELETE /api/curriculums/:id&#xa;GET /api/curriculums/:curriculumId/semesters/list&#xa;POST /api/curriculums/:curriculumId/semesters&#xa;PUT /api/curriculums/semesters/:semesterId&#xa;GET /api/curriculums/semesters/:semesterId/courses&#xa;POST /api/curriculums/.../courses&#xa;PUT /api/curriculums/courses/:courseId" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;portConstraint=eastwest;fontSize=10;" vertex="1" parent="CurriculumRouter">
          <mxGeometry y="30" width="320" height="120" as="geometry" />
        </mxCell>

        <!-- CurriculumController -->
        <mxCell id="CurriculumController" value="&lt;b&gt;CurriculumController&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="70" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="CurriculumController-methods" value="+getCurriculums(req): Response&#xa;+getCurriculumById(req): Response&#xa;+getCurriculumWithDetails(req): Response&#xa;+createCurriculum(req): Response&#xa;+updateCurriculum(req): Response&#xa;+deleteCurriculum(req): Response&#xa;+getSemesters(req): Response&#xa;+createSemester(req): Response&#xa;+getCourses(req): Response&#xa;+addCourse(req): Response" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;portConstraint=eastwest;fontSize=10;" vertex="1" parent="CurriculumController">
          <mxGeometry y="30" width="320" height="100" as="geometry" />
        </mxCell>

        <!-- CurriculumService / SemesterService / CourseService -->
        <mxCell id="CurriculumService" value="&lt;b&gt;CurriculumService&lt;/b&gt;&#xa;&lt;b&gt;CurriculumSemesterService&lt;/b&gt;&#xa;&lt;b&gt;CurriculumCourseService&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="860" y="70" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="CurriculumService-methods" value="+getCurriculums(filters): Curriculum[]&#xa;+getCurriculumById(id): Curriculum&#xa;+createCurriculum(data): Curriculum&#xa;+updateCurriculum(id, data): Curriculum&#xa;+getSemesters(curriculumId): CurriculumSemester[]&#xa;+createSemester(curriculumId, data): CurriculumSemester&#xa;+getCourses(semesterId): CurriculumCourse[]&#xa;+addCourse(semesterId, data): CurriculumCourse" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;portConstraint=eastwest;fontSize=10;" vertex="1" parent="CurriculumService">
          <mxGeometry y="30" width="340" height="80" as="geometry" />
        </mxCell>

        <!-- CurriculumRepository -->
        <mxCell id="CurriculumRepository" value="&lt;b&gt;CurriculumRepository&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="860" y="250" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="CurriculumRepository-methods" value="+findById(id): Curriculum&#xa;+findAll(filters): Curriculum[]&#xa;+save(curriculum): Curriculum&#xa;+delete(id): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;portConstraint=eastwest;fontSize=10;" vertex="1" parent="CurriculumRepository">
          <mxGeometry y="30" width="340" height="60" as="geometry" />
        </mxCell>

        <!-- Entities -->
        <mxCell id="Curriculum" value="&lt;b&gt;Curriculum&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="410" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="Curriculum-fields" value="-id: ObjectId&#xa;-code: string&#xa;-major: string&#xa;-academicYear: string&#xa;-name: string&#xa;-isActive: boolean&#xa;-createdAt: Date" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;portConstraint=eastwest;fontSize=10;" vertex="1" parent="Curriculum">
          <mxGeometry y="30" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="CurriculumSemester" value="&lt;b&gt;CurriculumSemester&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="410" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="CurriculumSemester-fields" value="-id: ObjectId&#xa;-curriculum: ObjectId (ref Curriculum)&#xa;-semesterOrder: number&#xa;-name: string" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;portConstraint=eastwest;fontSize=10;" vertex="1" parent="CurriculumSemester">
          <mxGeometry y="30" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="CurriculumCourse" value="&lt;b&gt;CurriculumCourse&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="410" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="CurriculumCourse-fields" value="-id: ObjectId&#xa;-curriculumSemester: ObjectId&#xa;-subject: ObjectId (ref Subject)&#xa;-credits: number&#xa;-isRequired: boolean&#xa;-order: number" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;portConstraint=eastwest;fontSize=10;" vertex="1" parent="CurriculumCourse">
          <mxGeometry y="30" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="Subject" value="&lt;b&gt;Subject&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="410" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="Subject-fields" value="-id: ObjectId&#xa;-subjectCode: string&#xa;-subjectName: string&#xa;-credits: number" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;portConstraint=eastwest;fontSize=10;" vertex="1" parent="Subject">
          <mxGeometry y="30" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Associations -->
        <mxCell id="rel1" value="" style="endArrow=open;endFill=1;endSize=12;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="CurriculumRouter-route" target="CurriculumController-methods">
