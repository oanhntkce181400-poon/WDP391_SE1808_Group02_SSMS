        <!-- Association: CurriculumCourse → Subject -->
        <mxCell id="rel6" value="" style="endArrow=open;endFill=1;endSize=12;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="CurriculumCourse-fields" target="Subject-fields">
