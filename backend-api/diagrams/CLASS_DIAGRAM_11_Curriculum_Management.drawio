        <!-- Composition: CurriculumSemester ◆→ Curriculum -->
        <mxCell id="rel4" value="" style="endArrow=diamondThin;endFill=1;endSize=16;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="CurriculumSemester-fields" target="Curriculum-fields">
