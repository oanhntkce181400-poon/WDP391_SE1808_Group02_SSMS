<mxfile host="app.diagrams.net">
  <diagram id="GenerateTranscript" name="Generate Student Transcript">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Class Diagram: Generate Student Transcript" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="520" height="30" as="geometry" />
        </mxCell>

        <mxCell id="R1" value="TranscriptRouter" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="R1r" value="GET /api/grades/transcript/generate&#xa;GET /api/grades/transcript/generate/:studentId" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="R1">
          <mxGeometry y="30" width="300" height="30" as="geometry" />
        </mxCell>

        <mxCell id="C1" value="TranscriptController" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="60" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="C1m" value="+generateTranscript(req): PDF / JSON error&#xa;+generateStudentTranscript(req): PDF" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="C1">
          <mxGeometry y="30" width="320" height="30" as="geometry" />
        </mxCell>

        <mxCell id="S1" value="TranscriptService" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="60" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="S1m" value="+getPreview(studentId, options): TranscriptPreviewDTO&#xa;+generatePDF(studentId, options): Buffer&#xa;+logTranscriptRequest(studentId, userId, options): Transcript" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="S1">
          <mxGeometry y="30" width="340" height="60" as="geometry" />
        </mxCell>

        <mxCell id="E1" value="Student" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="E1a" value="-id: ObjectId&#xa;-userId: ObjectId&#xa;-studentCode: string&#xa;-fullName: string&#xa;-majorCode: string" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="E1">
          <mxGeometry y="30" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="E2" value="ClassEnrollment" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="220" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="E2a" value="-student: ObjectId&#xa;-classSection: ObjectId&#xa;-grade: number&#xa;-isFinalized: boolean" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="E2">
          <mxGeometry y="30" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="E3" value="Transcript" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="220" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="E3a" value="-student: ObjectId&#xa;-requestedBy: ObjectId&#xa;-createdAt: Date&#xa;-options: object" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="E3">
          <mxGeometry y="30" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="DTO" value="TranscriptPreviewDTO" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="390" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="DTOa" value="+studentInfo: object&#xa;+summary: { totalCredits, cumulativeGPA, semesters }&#xa;+semesters: object" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="DTO">
          <mxGeometry y="30" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="endArrow=open;endFill=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="R1r" target="C1m"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=open;endFill=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="C1m" target="S1m"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="endArrow=open;endFill=1;html=1;exitX=0.3;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="S1" target="E1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="endArrow=open;endFill=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="S1" target="E2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="endArrow=open;endFill=1;html=1;exitX=0.7;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="S1" target="E3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="endArrow=open;endFill=1;dashed=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="S1" target="DTO"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6l" value="returns" style="edgeLabel;html=1;align=center;fontSize=9;" vertex="1" connectable="0" parent="e6"><mxGeometry relative="1" as="geometry"><mxPoint y="-6" as="offset" /></mxGeometry></mxCell>

        <mxCell id="n1" value="AuthMiddleware&#xa;RBAC: admin/staff for :studentId" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="160" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n1e" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1" source="R1" target="n1"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
