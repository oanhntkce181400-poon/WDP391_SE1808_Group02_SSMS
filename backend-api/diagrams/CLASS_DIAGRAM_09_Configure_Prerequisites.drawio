<mxfile host="app.diagrams.net">
  <diagram id="ConfigurePrerequisites" name="Configure Prerequisites">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Class Diagram: Configure Prerequisites&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="350" height="30" as="geometry" />
        </mxCell>

        <!-- SubjectRouter -->
        <mxCell id="SubjectRouter" value="&lt;b&gt;SubjectRouter&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="70" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="SubjectRouter-route" value="PUT /api/subjects/:id/prerequisites&#xa;GET /api/subjects/:id/prerequisites" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;portConstraint=eastwest;fontSize=10;" vertex="1" parent="SubjectRouter">
          <mxGeometry y="30" width="260" height="30" as="geometry" />
        </mxCell>

        <!-- SubjectController -->
        <mxCell id="SubjectController" value="&lt;b&gt;SubjectController&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="70" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="SubjectController-methods" value="+updatePrerequisites(req): Response&#xa;+getPrerequisites(req): Response" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;portConstraint=eastwest;fontSize=10;" vertex="1" parent="SubjectController">
          <mxGeometry y="30" width="280" height="30" as="geometry" />
        </mxCell>

        <!-- SubjectService -->
        <mxCell id="SubjectService" value="&lt;b&gt;SubjectService&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="70" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="SubjectService-methods" value="+updatePrerequisites(id, prerequisites): Subject&#xa;+getPrerequisites(id): Prerequisites[]" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;portConstraint=eastwest;fontSize=10;" vertex="1" parent="SubjectService">
          <mxGeometry y="30" width="300" height="30" as="geometry" />
        </mxCell>

        <!-- SubjectRepository -->
        <mxCell id="SubjectRepository" value="&lt;b&gt;SubjectRepository&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="200" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="SubjectRepository-methods" value="+findById(id): Subject&#xa;+save(subject): Subject&#xa;+findBySubjectCode(code): Subject" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;portConstraint=eastwest;fontSize=10;" vertex="1" parent="SubjectRepository">
          <mxGeometry y="30" width="300" height="60" as="geometry" />
        </mxCell>

        <!-- Subject (Entity) -->
        <mxCell id="Subject" value="&lt;b&gt;Subject&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="360" width="280" height="160" as="geometry" />
        </mxCell>
        <mxCell id="Subject-fields" value="-id: ObjectId&#xa;-subjectCode: string&#xa;-subjectName: string&#xa;-credits: number&#xa;-tuitionFee: number&#xa;-majorCode: string&#xa;-facultyCode: string&#xa;-prerequisites: [{ code, name }]&#xa;-teachers: [ObjectId]&#xa;-suggestedSemester: number&#xa;-isActive: boolean" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;portConstraint=eastwest;fontSize=10;" vertex="1" parent="Subject">
          <mxGeometry y="30" width="280" height="130" as="geometry" />
        </mxCell>

        <!-- PrerequisitesDTO -->
        <mxCell id="PrerequisitesDTO" value="&lt;b&gt;PrerequisitesDTO&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="360" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="PrerequisitesDTO-fields" value="+prerequisites: [{ code, name }]" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;portConstraint=eastwest;fontSize=10;" vertex="1" parent="PrerequisitesDTO">
          <mxGeometry y="30" width="200" height="30" as="geometry" />
        </mxCell>

        <!-- Associations -->
        <mxCell id="rel1" value="" style="endArrow=open;endFill=1;endSize=12;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="SubjectRouter-route" target="SubjectController-methods">
          <mxGeometry width="160" relative="1" as="geometry"><mxPoint x="340" y="100" as="sourcePoint" /><mxPoint x="400" y="100" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="rel2" value="" style="endArrow=open;endFill=1;endSize=12;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="SubjectController-methods" target="SubjectService-methods">
          <mxGeometry width="160" relative="1" as="geometry"><mxPoint x="680" y="100" as="sourcePoint" /><mxPoint x="760" y="100" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="rel3" value="" style="endArrow=open;endFill=1;endSize=12;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="SubjectService" target="SubjectRepository">
          <mxGeometry width="160" relative="1" as="geometry"><mxPoint x="910" y="130" as="sourcePoint" /><mxPoint x="910" y="200" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="rel3-lbl" value="uses" style="edgeLabel;html=1;align=center;fontSize=9;" vertex="1" connectable="0" parent="rel3"><mxGeometry x="-0.1" y="1" relative="1" as="geometry"><mxPoint y="-8" as="offset" /></mxGeometry></mxCell>
        <mxCell id="rel4" value="" style="endArrow=open;endFill=1;endSize=12;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="SubjectRepository" target="Subject">
          <mxGeometry width="160" relative="1" as="geometry"><mxPoint x="910" y="290" as="sourcePoint" /><mxPoint x="520" y="360" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="rel4-lbl" value="maps to" style="edgeLabel;html=1;align=center;fontSize=9;" vertex="1" connectable="0" parent="rel4"><mxGeometry x="-0.1" y="1" relative="1" as="geometry"><mxPoint y="-8" as="offset" /></mxGeometry></mxCell>
        
        <!-- Dependency: Service returns/updates DTO -->
        <mxCell id="rel5" value="" style="endArrow=open;endFill=1;endSize=12;html=1;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="SubjectService-methods" target="PrerequisitesDTO-fields">
          <mxGeometry width="160" relative="1" as="geometry"><mxPoint x="760" y="100" as="sourcePoint" /><mxPoint x="280" y="395" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="note1" value="&lt;i&gt;uses: AuthMiddleware,&#xa;RBACMiddleware (admin/staff)&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="80" y="150" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="note1-link" value="" style="endArrow=none;dashed=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="SubjectRouter" target="note1">
          <mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="210" y="130" as="sourcePoint" /><mxPoint x="150" y="150" as="targetPoint" /></mxGeometry>
