        <!-- Association Service -> Repository -->
        <mxCell id="rel3" value="" style="endArrow=open;endFill=1;endSize=12;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="SemesterService" target="SemesterRepository">
          <mxGeometry width="160" relative="1" as="geometry">
            <mxPoint x="800" y="140" as="sourcePoint" />
            <mxPoint x="800" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rel3-label" value="&#171;uses&#187;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;" vertex="1" connectable="0" parent="rel3">
          <mxGeometry x="-0.1" y="1" relative="1" as="geometry"><mxPoint y="-8" as="offset" /></mxGeometry>
        </mxCell>

        <!-- Association Repository -> Semester (entity) -->
        <mxCell id="rel4" value="" style="endArrow=open;endFill=1;endSize=12;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="SemesterRepository-methods" target="Semester-fields">
          <mxGeometry width="160" relative="1" as="geometry">
            <mxPoint x="680" y="235" as="sourcePoint" />
            <mxPoint x="470" y="285" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rel4-label" value="&#171;reads&#187;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;" vertex="1" connectable="0" parent="rel4">
          <mxGeometry x="-0.1" y="1" relative="1" as="geometry"><mxPoint y="-8" as="offset" /></mxGeometry>
        </mxCell>

        <!-- Note: uses AuthMiddleware -->
        <mxCell id="note1" value="&lt;i&gt;uses: AuthMiddleware&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="160" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="note1-link" value="" style="endArrow=none;dashed=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="SemesterRouter" target="note1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="190" y="140" as="sourcePoint" />
