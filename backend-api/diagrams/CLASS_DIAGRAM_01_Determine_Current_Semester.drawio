<mxfile host="app.diagrams.net">
  <diagram id="DetermineCurrentSemester" name="Determine Current Semester">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Class Diagram: Determine Current Semester&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="400" height="30" as="geometry" />
        </mxCell>

        <!-- SemesterRouter -->
        <mxCell id="SemesterRouter" value="&lt;b&gt;SemesterRouter&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="70" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="SemesterRouter-route" value="GET /api/semesters/current" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;portConstraint=eastwest;fontSize=10;" vertex="1" parent="SemesterRouter">
          <mxGeometry y="30" width="220" height="40" as="geometry" />
        </mxCell>

        <!-- SemesterController -->
        <mxCell id="SemesterController" value="&lt;b&gt;SemesterController&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="70" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="SemesterController-methods" value="+getCurrentSemester(req): Response" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="SemesterController">
          <mxGeometry y="30" width="240" height="40" as="geometry" />
        </mxCell>

        <!-- SemesterService -->
        <mxCell id="SemesterService" value="&lt;b&gt;SemesterService&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="70" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="SemesterService-methods" value="+getCurrentSemester(): Semester?" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="SemesterService">
          <mxGeometry y="30" width="240" height="40" as="geometry" />
        </mxCell>

        <!-- SemesterRepository -->
        <mxCell id="SemesterRepository" value="&lt;b&gt;SemesterRepository&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="200" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="SemesterRepository-methods" value="+findCurrentSemester(): Semester?&#xa;+findById(id): Semester?" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="SemesterRepository">
          <mxGeometry y="30" width="240" height="40" as="geometry" />
        </mxCell>

        <!-- Semester (Entity) -->
        <mxCell id="Semester" value="&lt;b&gt;Semester&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="200" width="220" height="170" as="geometry" />
        </mxCell>
        <mxCell id="Semester-fields" value="-id: ObjectId&#xa;-code: string&#xa;-name: string&#xa;-semesterType: string&#xa;-semesterNum: number&#xa;-academicYear: string&#xa;-startDate: Date&#xa;-endDate: Date&#xa;-isCurrent: boolean&#xa;-isActive: boolean&#xa;-createdAt: Date&#xa;-updatedAt: Date" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="Semester">
          <mxGeometry y="30" width="220" height="140" as="geometry" />
        </mxCell>

        <!-- Relationships: Association Router -> Controller -->
        <mxCell id="rel1" value="" style="endArrow=open;endFill=1;endSize=12;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="SemesterRouter-route" target="SemesterController-methods">
          <mxGeometry width="160" relative="1" as="geometry">
